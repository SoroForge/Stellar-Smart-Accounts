# ============================================================
# stellar-smart-accounts — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Stellar Network
# Options: mainnet | testnet | futurenet | standalone
STELLAR_NETWORK=testnet

# Soroban RPC endpoint for the chosen network
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://soroban.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (auto-set by SDK if STELLAR_NETWORK is provided,
# but can be overridden here for custom/standalone networks)
# STELLAR_NETWORK_PASSPHRASE=

# Deployer account secret key (for deploy scripts only — keep this safe!)
# STELLAR_SECRET=S...

# Deployed contract IDs (populated after running scripts/deploy.sh)
# SMART_WALLET_CONTRACT_ID=C...
# SESSION_KEYS_CONTRACT_ID=C...
# SPENDING_LIMITS_CONTRACT_ID=C...

# Demo app env (VITE_ prefix required for Vite)
# VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# VITE_SMART_WALLET_CONTRACT_ID=
# VITE_SESSION_KEYS_CONTRACT_ID=
# VITE_SPENDING_LIMITS_CONTRACT_ID=
