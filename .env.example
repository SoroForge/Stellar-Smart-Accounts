# ============================================================
# stellar-smart-accounts — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Stellar Network
# Options: mainnet | testnet | futurenet | standalone
STELLAR_NETWORK=testnet

# Soroban RPC endpoint for the chosen network
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://soroban.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (auto-set by SDK if STELLAR_NETWORK is provided,
# but can be overridden here for custom/standalone networks)
# STELLAR_NETWORK_PASSPHRASE=

# Deployer account secret key (for deploy scripts only — keep this safe!)
# STELLAR_SECRET=S...

# Deployed contract IDs (Testnet - Updated July 6, 2026)
SMART_WALLET_CONTRACT_ID=CBUEUWCNWF3Q5KCDA46SCBREGZUY5DVIF25T52D6MRYPKWWHJLLSWDP4
SESSION_KEYS_CONTRACT_ID=CBMJ52UOFODPM2THFP7E4ZO73LTPROEXRUPJO7LCSB6UTVIP7AO4JGT3
SPENDING_LIMITS_CONTRACT_ID=CDVQB6HYHLBZRRA5SKO2M55HBVZ2PLEFCLDP6662WFK7QSKW6RJMVDA5

