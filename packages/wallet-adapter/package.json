{
  "name": "@stellar-smart-accounts/wallet-adapter",
  "version": "0.0.1",
  "description": "Drop-in wallet connector adapter for stellar-smart-accounts (Freighter, xBull, Lobstr)",
  "keywords": [
    "stellar",
    "wallet",
    "freighter",
    "adapter",
    "account-abstraction"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./freighter": {
      "import": "./dist/adapters/freighter.js",
      "types": "./dist/adapters/freighter.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar-smart-accounts/sdk": "workspace:*",
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=12.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
